# ========================================================
# OpsLens Configuration Template (.env.example)
# Copy this file to .env and fill in your actual credentials
# ========================================================

# Exasol Database Connection
EXA_HOST=localhost
EXA_PORT=8563
EXA_USER=sys
EXA_PASSWORD=exasol
EXA_SCHEMA=OPSLENS
EXA_VERIFY_CERT=false
EXA_ENCRYPTION=true

# Optional LLM Provider Configuration (gemini | claude | openai)
LLM_PROVIDER=gemini
LLM_API_KEY=

# Optional Notification Webhook
SLACK_WEBHOOK_URL=
